# Ensure consistent line endings and text handling.
* text=auto eol=lf

# Rust sources
*.rs text diff=rust
*.toml text
*.md text
*.json text
*.yaml text
*.yml text

# Windows batch / PowerShell (keep CRLF if already CRLF)
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
